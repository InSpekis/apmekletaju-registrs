# Nokopējiet šo failu uz droši glabātu vides konfigurāciju; neiekļaujiet īstas paroles Git repozitorijā.
VISITOR_REGISTRY_ADMIN_PASSWORD=ievadiet-garu-un-uniku-paroli
# Izveidojiet, piemēram: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VISITOR_REGISTRY_SESSION_SECRET=nomainiet-ar-garu-nejausu-slepeno-atslegu
VISITOR_REGISTRY_COMPANY=Jūsu uzņēmuma nosaukums
VISITOR_REGISTRY_TIMEZONE=Europe/Riga
# Datu dzēšanas pārbaudes intervāls sekundēs (noklusējums: 3600).
VISITOR_REGISTRY_RETENTION_SWEEP_SECONDS=3600
# HTTPS: lokālai pārbaudei palaidiet ./scripts/generate-local-certificate.sh.
VISITOR_REGISTRY_PORT=8443
VISITOR_REGISTRY_TLS_CERTIFICATE=certs/localhost.crt
VISITOR_REGISTRY_TLS_PRIVATE_KEY=certs/localhost.key
# Iestatiet true tikai tad, ja lietotne ir pieejama ar HTTPS.
VISITOR_REGISTRY_SECURE_COOKIES=true
